{
    "name": "rpnfernandes/rff-qrcode",
    "description": "Zero-dependency pure PHP QR Code generator (ISO/IEC 18004 compliant, Versions 1-40) with SVG and Data URI rendering.",
    "keywords": [
        "qrcode",
        "qr-code",
        "qr",
        "generator",
        "svg",
        "vector",
        "psr-4",
        "zero-dependency",
        "pure-php"
    ],
    "homepage": "https://github.com/rpnfernandes/rff-qrcode",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rui Fernandes",
            "homepage": "https://github.com/rpnfernandes",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/rpnfernandes/rff-qrcode/issues",
        "source": "https://github.com/rpnfernandes/rff-qrcode"
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "RFF\\QrCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RFF\\QrCode\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
